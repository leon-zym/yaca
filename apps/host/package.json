{
  "name": "@yaca/host",
  "private": true,
  "type": "module",
  "bin": {
    "yaca": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build.mjs",
    "dev": "tsx src/cli.ts",
    "pretest": "pnpm --filter @yaca/contracts build && pnpm --filter @yaca/web build && pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "@yaca/contracts": "workspace:*",
    "fastify": "5.12.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "esbuild": "0.25.12",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
